# Settings for the site server (ebk/settings.py). None of these is a secret.
SITE_DB=site.db
# Comma-separated origins allowed by CORS; empty = same-origin only
PUBLIC_ORIGIN=
# Comma-separated Host headers served; empty = any
PUBLIC_HOSTS=
PUBLIC_RATE_PER_MIN=120
PUBLIC_BURST=40
# true only behind a proxy you run: the client address is then read from X-Forwarded-For
TRUST_PROXY=false
