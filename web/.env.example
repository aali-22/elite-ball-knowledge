# Where the web app forwards /api/public/* (the site server)
API_BASE=http://127.0.0.1:8030
# The site's public address (canonical links, the sitemap, the social card)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = search engines may index the site. Leave unset for previews and local runs.
NEXT_PUBLIC_INDEXABLE=
# Team marks and player photos (hotlinked decoration). 0 = monograms only, no third-party image
NEXT_PUBLIC_TEAM_MEDIA=1
