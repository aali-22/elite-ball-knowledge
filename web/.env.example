# Where the web app forwards /api/public/* (the site server)
API_BASE=http://127.0.0.1:8030
# The site's public address (canonical links, the sitemap, the social card)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = search engines may index the site. Leave unset for previews and local runs.
NEXT_PUBLIC_INDEXABLE=
# Team marks and player photos (hotlinked decoration). 0 = monograms only, no third-party image
NEXT_PUBLIC_TEAM_MEDIA=1
# 1 = the PickLab section is part of the site. Unset = the analytics alone (no link to it, its pages answer 404)
NEXT_PUBLIC_PICKLAB=1
# How long (seconds) a document from the API is served from the server's cache before it is refreshed. Default 300
EBK_FRESH_SECONDS=
# 1 = accounts are part of the site: sign-in, /account, /pricing, /api/auth, /api/pro. Unset = none of it exists (404)
NEXT_PUBLIC_ACCOUNTS=
# on = plans matter: a paid feature needs a paid plan. off (the default) = every feature is open to everyone
PAYWALL=off
# The accounts database, a postgres:// address. Required on a host (then run `npm run db:migrate` once).
# Unset on your own machine = an embedded Postgres under web/.data that makes its own tables
DATABASE_URL=
# Signs the session cookie. Required on a host: 32 random bytes (`openssl rand -hex 32`). Unset locally = made once, kept in web/.data
BETTER_AUTH_SECRET=
# The site's address as the accounts library sees it. Unset = NEXT_PUBLIC_SITE_URL on a host, the request's own address locally
BETTER_AUTH_URL=
# Google sign-in: offered only when both are set (redirect address: <site>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stripe billing: on only when all three are set (webhook address: <site>/api/auth/stripe/webhook).
# Test-mode keys only; a live key is refused unless STRIPE_LIVE=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_LIVE=
